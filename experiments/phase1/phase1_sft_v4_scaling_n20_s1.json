  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n    \n    if not text:\n        raise ValueError(\"Input is empty\")\n\n    try:\n        # Remove commas and convert to lowercase for consistency\n        text = text.replace(\"$\", \"\").replace(\",\", \"\").lower()\n\n        # Check for currency symbols\n        if text.startswith(\"-\"):\n            sign = -1\n            text = text[1:]\n        elif text.endswith(\"-\"):\n            sign = -1\n            text = text[:-1]\n        else:\n            sign = 1\n\n        # Split by spaces and remove any remaining whitespace\n        words = text.split()\n        \n        # Convert words to numbers\n        total = sum(float(word) * sign for word in words)\n        return total\n    except ValueError:\n        raise ValueError(\"Invalid amount format\")"
}
