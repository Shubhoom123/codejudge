  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    sign = -1 if text.startswith(\"-\") else 1\n    num_str = text.lstrip(\"-\")\n\n    if num_str == \"fifty\":\n        return 50.0\n    elif num_str == \"one hundred\":\n        return 100.0\n    elif num_str == \"two hundred\":\n        return 200.0\n    elif num_str == \"three hundred\":\n        return 300.0\n    elif num_str == \"four hundred\":\n        return 400.0\n    elif num_str == \"five hundred\":\n        return 500.0\n    elif num_str == \"six hundred\":\n        return 600.0\n    elif num_str == \"seven hundred\":\n        return 700.0\n    elif num_str == \"eight hundred\":\n        return 800.0\n    elif num_str == \"nine hundred\":\n        return 900.0\n    elif num_str == \"thousand\":\n        return 1000.0\n    elif num_str == \"million\":\n        return 1000000.0\n\n\n    try:\n        return sign * float(num_str)\n    except ValueError:\n        # Attempt to parse written numbers\n        try:\n            num = number_to_float(num_str)\n            return sign * num\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n\ndef number_to_float(number_str):\n    \"\"\"Converts a written number (e.g., 'fifty', 'one hundred') to a float.\"\"\"\n    number_words = {\n        \"zero\": 0,\n        \"one\": 1,\n        \"two\": 2,\n        \"three\": 3,\n        \"four\": 4,\n        \"five\": 5,\n        \"six\": 6,\n        \"seven\": 7,\n        \"eight\": 8,\n        \"nine\": 9,\n        \"ten\": 10,\n        \"eleven\": 11,\n        \"twelve\": 12,\n        \"thirteen\": 13,\n        \"fourteen\": 14,\n        \"fifteen\": 15,\n        \"sixteen\": 16,\n        \"seventeen\": 17,\n        \"eighteen\": 18,\n        \"nineteen\": 19,\n        \"twenty\": 20,\n        \"thirty\": 30,\n        \"forty\": 40,\n        \"fifty\": 50,\n        \"sixty\": 60,\n        \"seventy\": 70,\n        \"eighty\": 80,\n        \"ninety\": 90,\n        \"hundred\": 100,\n        \"thousand\": 1000,\n        \"million\": 1000000,\n    }\n\n    words = number_str.split()\n    total = 0\n    multiplier = 1\n\n    for i in range(len(words) - 1, -1, -1):\n        word = words[i]\n        if word == \"hundred\":\n            multiplier *= 100\n        elif word == \"thousand\":\n            multiplier *= 1000\n        elif word == \"million\":\n            multiplier *= 1000000\n        else:\n            try:\n                num = number_words[word]\n                total += num * multiplier\n                multiplier = 1\n            except KeyError:\n                raise ValueError(\"Invalid amount format\")\n\n    return float(total)"
}
