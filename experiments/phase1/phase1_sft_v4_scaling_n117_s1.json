  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    sign = 1\n    if text.startswith(\"-\"):\n        sign = -1\n        text = text[1:]\n\n    try:\n        amount = float(text)\n    except ValueError:\n        # Attempt to parse written numbers\n        words = text.lower().split()\n        total = 0\n        multiplier = 1\n        for i in range(len(words) - 1, -1, -1):\n            word = words[i]\n            if word == \"hundred\":\n                multiplier *= 100\n            elif word == \"thousand\":\n                multiplier *= 1000\n            elif word == \"million\":\n                multiplier *= 1000000\n            else:\n                try:\n                    num = int(word)\n                    total += num * multiplier\n                except ValueError:\n                     raise ValueError(\"Invalid amount format\")\n\n        amount = total\n\n\n    return sign * amount"
}
