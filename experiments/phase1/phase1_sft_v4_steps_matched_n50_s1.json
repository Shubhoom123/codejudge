  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    sign = 1\n    if text.startswith(\"-\"):\n        sign = -1\n        text = text[1:]\n\n    try:\n        amount = float(text)\n    except ValueError:\n        # Attempt to parse written numbers\n        try:\n            amount = number_to_float(text)\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    return sign * amount\n\n\ndef number_to_float(text):\n    \"\"\"Converts a written number (e.g., \"fifty\", \"one hundred\") to a float.\"\"\"\n    written_numbers = {\n        \"zero\": 0,\n        \"one\": 1,\n        \"two\": 2,\n        \"three\": 3,\n        \"four\": 4,\n        \"five\": 5,\n        \"six\": 6,\n        \"seven\": 7,\n        \"eight\": 8,\n        \"nine\": 9,\n        \"ten\": 10,\n        \"eleven\": 11,\n        \"twelve\": 12,\n        \"thirteen\": 13,\n        \"fourteen\": 14,\n        \"fifteen\": 15,\n        \"sixteen\": 16,\n        \"seventeen\": 17,\n        \"eighteen\": 18,\n        \"nineteen\": 19,\n        \"twenty\": 20,\n        \"thirty\": 30,\n        \"forty\": 40,\n        \"fifty\": 50,\n        \"sixty\": 60,\n        \"seventy\": 70,\n        \"eighty\": 80,\n        \"ninety\": 90,\n        \"hundred\": 100,\n        \"thousand\": 1000,\n        \"million\": 1000000,\n    }\n\n    words = text.split()\n    total = 0\n    multiplier = 1\n\n    for i in range(len(words) - 1, -1, -1):\n        word = words[i].lower()\n        if word == \"hundred\":\n            multiplier *= 100\n        elif word == \"thousand\":\n            multiplier *= 1000\n        elif word == \"million\":\n            multiplier *= 1000000\n        else:\n            try:\n                num = written_numbers[word]\n                total += num * multiplier\n                multiplier = 1\n            except KeyError:\n                raise ValueError(\"Invalid amount format\")\n\n    return float(total)"
}
