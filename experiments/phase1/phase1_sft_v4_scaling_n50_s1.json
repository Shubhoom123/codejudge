  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    sign = -1 if text.startswith(\"-\") else 1\n    num_words = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9,\n        \"ten\": 10, \"eleven\": 11, \"twelve\": 12, \"thirteen\": 13,\n        \"fourteen\": 14, \"fifteen\": 15, \"sixteen\": 16, \"seventeen\": 17,\n        \"eighteen\": 18, \"nineteen\": 19, \"twenty\": 20, \"thirty\": 30,\n        \"forty\": 40, \"fifty\": 50, \"sixty\": 60, \"seventy\": 70,\n        \"eighty\": 80, \"ninety\": 90, \"hundred\": 100, \"thousand\": 1000,\n        \"million\": 1000000\n    }\n\n    words = text.split()\n    total = 0\n    multiplier = 1\n\n    for i in range(len(words) - 1, -1, -1):\n        word = words[i]\n        if word == \"hundred\":\n            multiplier *= 100\n        elif word == \"thousand\":\n            multiplier *= 1000\n        elif word == \"million\":\n            multiplier *= 1000000\n        else:\n            try:\n                num = num_words[word]\n                total += num * multiplier\n                multiplier = 1\n            except KeyError:\n                raise ValueError(\"Invalid amount format\")\n\n    return float(total)"
}
