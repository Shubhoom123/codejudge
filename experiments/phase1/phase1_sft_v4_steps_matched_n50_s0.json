  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    sign = 1\n    if text.startswith(\"-\"):\n        sign = -1\n        text = text[1:]\n\n    try:\n        amount = float(text)\n    except ValueError:\n        # Attempt to parse written numbers\n        words = text.split()\n        total = 0\n        multiplier = 1\n        for i in range(len(words) - 1, -1, -1):\n            word = words[i].lower()\n            if word == \"one\":\n                total += multiplier\n            elif word == \"two\":\n                total += multiplier * 2\n            elif word == \"three\":\n                total += multiplier * 3\n            elif word == \"four\":\n                total += multiplier * 4\n            elif word == \"five\":\n                total += multiplier * 5\n            elif word == \"six\":\n                total += multiplier * 6\n            elif word == \"seven\":\n                total += multiplier * 7\n            elif word == \"eight\":\n                total += multiplier * 8\n            elif word == \"nine\":\n                total += multiplier * 9\n            elif word == \"ten\":\n                total += multiplier * 10\n            elif word == \"eleven\":\n                total += multiplier * 11\n            elif word == \"twelve\":\n                total += multiplier * 12\n            elif word == \"thirteen\":\n                total += multiplier * 13\n            elif word == \"fourteen\":\n                total += multiplier * 14\n            elif word == \"fifteen\":\n                total += multiplier * 15\n            elif word == \"sixteen\":\n                total += multiplier * 16\n            elif word == \"seventeen\":\n                total += multiplier * 17\n            elif word == \"eighteen\":\n                total += multiplier * 18\n            elif word == \"nineteen\":\n                total += multiplier * 19\n            elif word == \"twenty\":\n                total += multiplier * 20\n            elif word == \"thirty\":\n                total += multiplier * 30\n            elif word == \"forty\":\n                total += multiplier * 40\n            elif word == \"fifty\":\n                total += multiplier * 50\n            elif word == \"sixty\":\n                total += multiplier * 60\n            elif word == \"seventy\":\n                total += multiplier * 70\n            elif word == \"eighty\":\n                total += multiplier * 80\n            elif word == \"ninety\":\n                total += multiplier * 90\n            elif word == \"hundred\":\n                multiplier *= 100\n            elif word == \"thousand\":\n                multiplier *= 1000\n            elif word == \"million\":\n                multiplier *= 1000000\n\n        if len(words) > 0 and words[0] == \"-\":\n            amount = -total / multiplier\n\n\n        if amount == 0:\n          raise ValueError(\"Invalid amount format\")\n\n\n        return float(amount)\n\n    return sign * float(text)"
}
