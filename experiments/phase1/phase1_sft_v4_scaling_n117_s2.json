  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    sign = 1\n    if text.startswith(\"-\"):\n        sign = -1\n        text = text[1:]\n\n    try:\n        amount = float(text)\n    except ValueError:\n        # Attempt to parse written numbers\n        words = text.split()\n        total = 0\n        i = 0\n        while i < len(words):\n            word = words[i].lower()\n            if word == \"zero\":\n                total += 0\n            elif word == \"one\":\n                total += 1\n            elif word == \"two\":\n                total += 2\n            elif word == \"three\":\n                total += 3\n            elif word == \"four\":\n                total += 4\n            elif word == \"five\":\n                total += 5\n            elif word == \"six\":\n                total += 6\n            elif word == \"seven\":\n                total += 7\n            elif word == \"eight\":\n                total += 8\n            elif word == \"nine\":\n                total += 9\n            elif word == \"ten\":\n                total += 10\n            elif word == \"eleven\":\n                total += 11\n            elif word == \"twelve\":\n                total += 12\n            elif word == \"thirteen\":\n                total += 13\n            elif word == \"fourteen\":\n                total += 14\n            elif word == \"fifteen\":\n                total += 15\n            elif word == \"sixteen\":\n                total += 16\n            elif word == \"seventeen\":\n                total += 17\n            elif word == \"eighteen\":\n                total += 18\n            elif word == \"nineteen\":\n                total += 19\n            elif word == \"twenty\":\n                total += 20\n            elif word == \"thirty\":\n                total += 30\n            elif word == \"forty\":\n                total += 40\n            elif word == \"fifty\":\n                total += 50\n            elif word == \"sixty\":\n                total += 60\n            elif word == \"seventy\":\n                total += 70\n            elif word == \"eighty\":\n                total += 80\n            elif word == \"ninety\":\n                total += 90\n            elif word == \"hundred\":\n                total *= 100\n            elif word == \"thousand\":\n                total *= 1000\n            elif word == \"million\":\n                total *= 1000000\n            else:\n                raise ValueError(\"Invalid amount format\")\n\n            i += 1\n\n\n        if sign == -1:\n          return -total\n        else:\n             return total\n\n\n\n    return sign * amount"
}
