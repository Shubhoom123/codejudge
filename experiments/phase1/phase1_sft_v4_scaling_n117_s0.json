  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    sign = 1\n    if text.startswith(\"-\"):\n        sign = -1\n        text = text[1:]\n\n    try:\n        amount = float(text)\n    except ValueError:\n        # Attempt to parse written numbers\n        words = text.lower().split()\n        num_words = {\"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n                     \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9,\n                     \"ten\": 10, \"eleven\": 11, \"twelve\": 12, \"thirteen\": 13,\n                     \"fourteen\": 14, \"fifteen\": 15, \"sixteen\": 16, \"seventeen\": 17,\n                     \"eighteen\": 18, \"nineteen\": 19, \"twenty\": 20, \"thirty\": 30,\n                     \"forty\": 40, \"fifty\": 50, \"sixty\": 60, \"seventy\": 70,\n                     \"eighty\": 80, \"ninety\": 90, \"hundred\": 100, \"thousand\": 1000,\n                     \"million\": 1000000}\n\n        total = 0\n        i = 0\n        while i < len(words):\n            word = words[i]\n            if word in num_words:\n                num = num_words[word]\n                if i + 1 < len(words) and words[i+1] == 'hundred':\n                    if i + 2 < len(words) and words[i+2] in ('thousand', 'million'):\n                        total += num * (num_words.get(words[i+2], 1))\n                        i+=3\n                    else:\n                        total += num * (num_words.get(words[i+2], 1))\n                        i+=2\n                elif i + 1 < len(words) and words[i+1] in ('thousand', 'million'):\n                     total += num * (num_words.get(words[i+1], 1))\n                     i+=2\n                else:\n                   total += num\n                   i+=1\n            else:\n                 raise ValueError(\"Invalid amount format\")\n\n        amount = total\n\n\n    return sign * amount"
}
