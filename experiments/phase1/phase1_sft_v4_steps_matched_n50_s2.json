  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount format\")\n\n    sign = 1\n    if text.startswith(\"-\"):\n        sign = -1\n        text = text[1:]\n\n    try:\n        amount = float(text)\n    except ValueError:\n        # Attempt to parse written numbers\n        words = text.lower().split()\n        num_str = \"\"\n        for word in words:\n            if word == \"zero\":\n                num_str += \"0\"\n            elif word == \"one\":\n                num_str += \"1\"\n            elif word == \"two\":\n                num_str += \"2\"\n            elif word == \"three\":\n                num_str += \"3\"\n            elif word == \"four\":\n                num_str += \"4\"\n            elif word == \"five\":\n                num_str += \"5\"\n            elif word == \"six\":\n                num_str += \"6\"\n            elif word == \"seven\":\n                num_str += \"7\"\n            elif word == \"eight\":\n                num_str += \"8\"\n            elif word == \"nine\":\n                num_str += \"9\"\n            elif word == \"ten\":\n                num_str += \"10\"\n            elif word == \"eleven\":\n                num_str += \"11\"\n            elif word == \"twelve\":\n                num_str += \"12\"\n            elif word == \"thirteen\":\n                num_str += \"13\"\n            elif word == \"fourteen\":\n                num_str += \"14\"\n            elif word == \"fifteen\":\n                num_str += \"15\"\n            elif word == \"sixteen\":\n                num_str += \"16\"\n            elif word == \"seventeen\":\n                num_str += \"17\"\n            elif word == \"eighteen\":\n                num_str += \"18\"\n            elif word == \"nineteen\":\n                num_str += \"19\"\n            elif word == \"twenty\":\n                num_str += \"20\"\n            elif word == \"thirty\":\n                num_str += \"30\"\n            elif word == \"forty\":\n                num_str += \"40\"\n            elif word == \"fifty\":\n                num_str += \"50\"\n            elif word == \"sixty\":\n                num_str += \"60\"\n            elif word == \"seventy\":\n                num_str += \"70\"\n            elif word == \"eighty\":\n                num_str += \"80\"\n            elif word == \"ninety\":\n                num_str += \"90\"\n            elif word == \"hundred\":\n                if len(num_str) > 0:\n                    num_str = num_str[:-1]\n                else:\n                     raise ValueError(\"Invalid amount format\")\n            elif word == \"thousand\":\n                 num_str = num_str + '00'\n            elif word == \"million\":\n                 num_str = num_str + '000'\n\n        try:\n            amount = float(num_str)\n        except ValueError:\n             raise ValueError(\"Invalid amount format\")\n\n\n    if sign < 0:\n       return -sign * amount\n    else:\n       return sign * amount"
}
