  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n\n    text = text.strip()\n\n    if not text:\n        raise ValueError(\"Cannot parse empty string\")\n\n    text = text.replace(\"$\", \"\")\n    text = text.replace(\",\", \"\")\n\n    if text.lower().endswith(\"dollars\"):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError(\"Invalid amount with 'dollars' suffix\")\n    elif text.lower().endswith(\"dollar\"):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError(\"Invalid amount with 'dollar' suffix\")\n\n    sign = 1\n    if text.startswith(\"-\"):\n        sign = -1\n        text = text[1:]\n\n    try:\n        amount = float(text)\n    except ValueError:\n        # Attempt to parse written numbers\n        words = text.lower().split()\n        amount = 0.0\n        i = 0\n        while i < len(words):\n            word = words[i]\n            if word == \"zero\":\n                amount += 0.0\n            elif word == \"one\":\n                amount += 1.0\n            elif word == \"two\":\n                amount += 2.0\n            elif word == \"three\":\n                amount += 3.0\n            elif word == \"four\":\n                amount += 4.0\n            elif word == \"five\":\n                amount += 5.0\n            elif word == \"six\":\n                amount += 6.0\n            elif word == \"seven\":\n                amount += 7.0\n            elif word == \"eight\":\n                amount += 8.0\n            elif word == \"nine\":\n                amount += 9.0\n            elif word == \"ten\":\n                amount += 10.0\n            elif word == \"eleven\":\n                amount += 11.0\n            elif word == \"twelve\":\n                amount += 12.0\n            elif word == \"thirteen\":\n                amount += 13.0\n            elif word == \"fourteen\":\n                amount += 14.0\n            elif word == \"fifteen\":\n                amount += 15.0\n            elif word == \"sixteen\":\n                amount += 16.0\n            elif word == \"seventeen\":\n                amount += 17.0\n            elif word == \"eighteen\":\n                amount += 18.0\n            elif word == \"nineteen\":\n                amount += 19.0\n            elif word == \"twenty\":\n                amount += 20.0\n            elif word == \"thirty\":\n                amount += 30.0\n            elif word == \"forty\":\n                amount += 40.0\n            elif word == \"fifty\":\n                amount += 50.0\n            elif word == \"sixty\":\n                amount += 60.0\n            elif word == \"seventy\":\n                amount += 70.0\n            elif word == \"eighty\":\n                amount += 80.0\n            elif word == \"ninety\":\n                amount += 90.0\n            elif word == \"hundred\":\n                amount *= 100.0\n            elif word == \"thousand\":\n                amount *= 1000.0\n            elif word == \"million\":\n                 amount *= 1000000.0\n            else:\n                raise ValueError(\"Invalid amount format\")\n\n            i += 1\n\n\n        return sign * amount\n    else:\n        return sign * amount"
}
