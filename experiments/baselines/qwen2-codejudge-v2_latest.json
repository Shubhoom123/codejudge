  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    text = text.strip()\n    if text.lower().endswith('dollars'):\n        text = text[:-7]\n    elif text.lower().endswith('dollar'):\n        text = text[:-6]\n    try:\n        amount_str = text.replace('$', '').replace(',', '')\n        return float(amount_str)\n    except ValueError:\n        raise ValueError(f'Could not parse amount: {text}')\n\ndef check_parse_amount():\n    assert parse_amount('$12.50') == 12.5, 'Test 1 failed'\n    assert parse_amount('100 dollars') == 100.0, 'Test 2 failed'\n    assert parse_amount(fifty) == 50.0, 'Test 3 failed'\n    assert parse_amount('$1,000') == 1000.0, 'Test 4 failed'\n    print('All tests passed!')"
