  "solution": "import re\n\ndef parse_amount(text: str) -> float:\n    \"\"\"Extracts a monetary amount from a user-typed string.\"\"\"\n    text = text.strip()\n    if not text:\n        raise ValueError('Empty input')\n    text = text.replace('$', '').replace(',', '')\n    if text.lower().endswith('dollars'):\n        try:\n            return float(text[:-7])\n        except ValueError:\n            raise ValueError('Invalid amount format')\n    elif text.lower().endswith('dollar'):\n        try:\n            return float(text[:-6])\n        except ValueError:\n            raise ValueError('Invalid amount format')\n    if text.startswith('-'):\n        sign = -1\n        num = text[1:]\n    else:\n        sign = 1\n        num = text\n    try:\n        num = float(num)\n        return sign * num\n    except ValueError:\n        raise ValueError('Invalid amount format')\n\ndef check(text, expected):\n    result = parse_amount(text)\n    if result == expected:\n        print(f\"PASS: '{text}' -> {result}\")\n    else:\n        print(f\"FAIL: '{text}' -> {expected} (got {result})\")"
}
